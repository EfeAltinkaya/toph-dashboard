// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Postgres in every environment, including local dev. Prisma's migration
// SQL is provider-specific, so keeping SQLite locally and Postgres in
// production would mean two migration histories that can drift apart —
// the classic "worked on my machine" failure. One provider, one history.
datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  // Which farm this account belongs to. A manager signing up creates one
  // and gets its join code; a worker signing up joins an existing one by
  // typing that code. Every query in the dashboard is filtered by it, so
  // one farm can never see another's records.
  farm         Farm     @relation(fields: [farmId], references: [id])
  farmId       Int
  // "manager" gets the full dashboard; "worker" gets a single log-activity
  // screen and nothing else — matches the real Toph/Furrow product's
  // role split, and lets someone join as a worker without being able to
  // see or touch anyone else's data.
  role         String   @default("manager")
  createdAt    DateTime @default(now())
  sessions     Session[]
  messages     Message[]
}

// The tenant. Everything a farm records belongs to exactly one of these,
// and the join code is how a worker proves they belong to it instead of
// being able to self-enroll into someone else's operation.
model Farm {
  id        Int      @id @default(autoincrement())
  name      String
  joinCode  String   @unique
  createdAt DateTime @default(now())
  users     User[]
  employees Employee[]
  logs      EmployeeLog[]
  messages  Message[]
}

model Session {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Tracked in the database, not in memory, since serverless deployment
// (Vercel) may run each request on a different, short-lived instance —
// an in-memory counter would silently stop protecting anything once
// deployed. See checkLoginRateLimit() in src/lib/rate-limit.ts.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Employee {
  id     Int           @id @default(autoincrement())
  name   String
  farm   Farm          @relation(fields: [farmId], references: [id])
  farmId Int
  logs   EmployeeLog[]

  // Names are unique within a farm, not globally: two farms can both
  // employ a Maria Lopez, and neither should block the other's signup.
  @@unique([farmId, name])
}

model Tag {
  id   Int           @id @default(autoincrement())
  name String        @unique
  logs EmployeeLog[]
}

model Message {
  id        Int      @id @default(autoincrement())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  farm      Farm     @relation(fields: [farmId], references: [id])
  farmId    Int
  body      String
  createdAt DateTime @default(now())
}

// Submissions from the public "Request a Briefing" form on the marketing
// site — a genuine write to the database, not a fake form that goes nowhere.
model BriefingRequest {
  id             Int      @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String
  company        String
  responsibility String
  context        String
  createdAt      DateTime @default(now())
}

model EmployeeLog {
  id         Int      @id @default(autoincrement())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId Int
  // Denormalized from the employee on purpose: every dashboard query
  // filters on it, and a farm-scoped index here beats joining through
  // Employee on every read.
  farm       Farm     @relation(fields: [farmId], references: [id])
  farmId     Int
  activity   String
  field      String
  date       DateTime
  startTime  String
  endTime    String
  isNew      Boolean  @default(true)
  accuracy   Int
  audioUrl   String
  photoUrl   String?
  transcript String
  language   String  @default("en-US")
  translated String?
  // Structured fields pulled out of the spoken transcript (see
  // src/lib/extract.ts) or typed in directly on the worker's Type tab.
  // Nullable because a log can be valid without a product application —
  // scouting or pruning has nothing to record here.
  product    String?
  target     String?
  rate       String?
  notes      String?
  // "voice" or "typed" — the extraction panel says which one it was, since
  // a typed entry is the worker's own words and a voice one is parsed.
  source     String  @default("voice")
  lat        Float
  lng        Float
  // Where lat/lng came from: "device" means the worker's browser handed
  // over a real GPS fix at the moment they filed the log, "field" means
  // it fell back to the block's known coordinates. An auditor cares about
  // the difference, so the record states which it is rather than showing
  // every pin as though it were measured.
  coordSource String  @default("field")
  // Application method (ground rig, airblast, backpack, chemigation).
  // California's use report is rejected outright without it, so it's
  // captured at the source instead of reconstructed later. Null for
  // activities that apply nothing.
  method     String?
  // Radius of the GPS fix in metres, as reported by the device. Null when
  // no fix was captured.
  gpsAccuracyM Float?
  tags       Tag[]
  createdAt  DateTime @default(now())

  @@index([farmId, date])
}
