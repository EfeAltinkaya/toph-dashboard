// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  // "manager" gets the full dashboard; "worker" gets a single log-activity
  // screen and nothing else — matches the real Toph/Furrow product's
  // role split, and lets someone join as a worker without being able to
  // see or touch anyone else's data.
  role         String   @default("manager")
  createdAt    DateTime @default(now())
  sessions     Session[]
  messages     Message[]
}

// A farm is just a join code gate in this build (there's one real farm in
// the demo data) — a worker signing up types this code to prove they
// belong, rather than anyone being able to self-enroll as an employee.
model Farm {
  id        Int      @id @default(autoincrement())
  name      String
  joinCode  String   @unique
  createdAt DateTime @default(now())
}

model Session {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Tracked in the database, not in memory, since serverless deployment
// (Vercel) may run each request on a different, short-lived instance —
// an in-memory counter would silently stop protecting anything once
// deployed. See checkLoginRateLimit() in src/lib/rate-limit.ts.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Employee {
  id   Int           @id @default(autoincrement())
  name String        @unique
  logs EmployeeLog[]
}

model Tag {
  id   Int           @id @default(autoincrement())
  name String        @unique
  logs EmployeeLog[]
}

model Message {
  id        Int      @id @default(autoincrement())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  body      String
  createdAt DateTime @default(now())
}

// Submissions from the public "Request a Briefing" form on the marketing
// site — a genuine write to the database, not a fake form that goes nowhere.
model BriefingRequest {
  id             Int      @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String
  company        String
  responsibility String
  context        String
  createdAt      DateTime @default(now())
}

model EmployeeLog {
  id         Int      @id @default(autoincrement())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId Int
  activity   String
  field      String
  date       DateTime
  startTime  String
  endTime    String
  isNew      Boolean  @default(true)
  accuracy   Int
  audioUrl   String
  photoUrl   String?
  transcript String
  language   String  @default("en-US")
  translated String?
  // Structured fields pulled out of the spoken transcript (see
  // src/lib/extract.ts) or typed in directly on the worker's Type tab.
  // Nullable because a log can be valid without a product application —
  // scouting or pruning has nothing to record here.
  product    String?
  target     String?
  rate       String?
  notes      String?
  // "voice" or "typed" — the extraction panel says which one it was, since
  // a typed entry is the worker's own words and a voice one is parsed.
  source     String  @default("voice")
  lat        Float
  lng        Float
  tags       Tag[]
  createdAt  DateTime @default(now())
}
