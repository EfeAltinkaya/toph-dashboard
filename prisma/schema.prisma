// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  sessions     Session[]
  messages     Message[]
}

model Session {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Tracked in the database, not in memory, since serverless deployment
// (Vercel) may run each request on a different, short-lived instance —
// an in-memory counter would silently stop protecting anything once
// deployed. See checkLoginRateLimit() in src/lib/rate-limit.ts.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Employee {
  id   Int           @id @default(autoincrement())
  name String        @unique
  logs EmployeeLog[]
}

model Tag {
  id   Int           @id @default(autoincrement())
  name String        @unique
  logs EmployeeLog[]
}

model Message {
  id        Int      @id @default(autoincrement())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  body      String
  createdAt DateTime @default(now())
}

model EmployeeLog {
  id         Int      @id @default(autoincrement())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId Int
  activity   String
  field      String
  date       DateTime
  startTime  String
  endTime    String
  isNew      Boolean  @default(true)
  accuracy   Int
  audioUrl   String
  photoUrl   String?
  transcript String
  language   String  @default("en-US")
  translated String?
  lat        Float
  lng        Float
  tags       Tag[]
  createdAt  DateTime @default(now())
}
